// Prisma schema for フジアルテ ATS.
// Source of truth for table/column definitions: ../../table-spec.html
// Build order follows ../../roadmap.html "データ構築順序":
//   STEP 0 — 認証基盤: Staff, StaffSession, AuditLog
//   STEP 1 — マスターデータ: Tag, School, Media, QRCode, SelectionFlow, SelectionStage
// Later steps (Applicant, Selection, LINE/Survey/CalendarSlot, ...) are added as
// subsequent migrations once STEP 0/1 are live.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== STEP 0: 認証基盤 =====

enum StaffRole {
  admin
  recruiter
  interviewer
  viewer

  @@map("staff_role")
}

enum StaffPositionAccess {
  sogo
  gino
  both

  @@map("staff_position_access")
}

enum AuditAction {
  login
  logout
  export
  status_change
  offer
  acceptance
  line_send
  edit_applicant
  document_export

  @@map("audit_action")
}

/// 担当者テーブル。他の全テーブルの created_by / assigned_to / changed_by が参照する。
model Staff {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String              @db.VarChar(100)
  email                String              @unique @db.VarChar(255)
  google_id            String              @unique @db.VarChar(255)
  garoon_user_id       String?             @db.VarChar(100)
  role                 StaffRole           @default(recruiter)
  is_active            Boolean             @default(true)
  position_type_access StaffPositionAccess @default(both)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt

  sessions                       StaffSession[]
  audit_logs                     AuditLog[]
  tags                           Tag[]
  tagged_applicant_tags          ApplicantTag[]
  assigned_selections            Selection[]            @relation("SelectionAssignee")
  selection_history_changes      SelectionHistory[]     @relation("SelectionHistoryChangedBy")
  interviews_conducted           Interview[]            @relation("InterviewInterviewer")
  evaluation_templates_created   EvaluationTemplate[]   @relation("EvaluationTemplateCreator")
  evaluation_responses_submitted EvaluationResponse[]   @relation("EvaluationResponseSubmitter")
  line_broadcasts_sent           LineBroadcast[]
  call_logs_recorded             CallLog[]              @relation("CallLogStaff")
  column_preference              StaffColumnPreference?

  @@index([email], map: "staff_email_idx")
  @@index([google_id], map: "staff_google_id_idx")
}

/// 応募者一覧の表示列カスタマイズ(FR099)。担当者ごとに1件。
model StaffColumnPreference {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id   String   @unique @db.Uuid
  // 表示する列キーを表示順に並べたJSON配列(例: ["email","school"])。
  // 含まれない列は非表示として扱う。
  columns    Json
  updated_at DateTime @updatedAt

  staff Staff @relation(fields: [staff_id], references: [id], onDelete: Cascade)
}

/// セッション管理テーブル。
model StaffSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id      String    @db.Uuid
  ip_address    String    @db.VarChar(45)
  user_agent    String    @db.VarChar(500)
  logged_in_at  DateTime  @default(now())
  logged_out_at DateTime?

  staff Staff @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@index([staff_id, logged_out_at], map: "session_staff_idx")
}

/// 監査ログテーブル。INSERT ONLY（削除・更新禁止、保存期間3年）。
model AuditLog {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id     String      @db.Uuid
  action       AuditAction
  target_type  String?     @db.VarChar(50)
  target_id    String?     @db.Uuid
  before_value Json?
  after_value  Json?
  ip_address   String      @db.VarChar(45)
  created_at   DateTime    @default(now())

  staff Staff @relation(fields: [staff_id], references: [id])

  @@index([staff_id, created_at], map: "audit_staff_idx")
  @@index([target_type, target_id], map: "audit_target_idx")
}

// ===== STEP 1: マスターデータ =====

enum SchoolType {
  university        @map("大学")
  graduate_school   @map("大学院")
  junior_college    @map("短大")
  vocational_school @map("専門")
  kosen             @map("高専")

  @@map("school_type")
}

enum MediaSyncType {
  api
  csv

  @@map("media_sync_type")
}

enum StageType {
  entry
  screening
  interview_1st
  interview_2nd
  interview_final
  offer
  acceptance

  @@map("stage_type")
}

/// タグマスター。
model Tag {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String @unique @db.VarChar(50)
  color      String @db.VarChar(7)
  created_by String @db.Uuid

  creator         Staff           @relation(fields: [created_by], references: [id])
  applicant_tags  ApplicantTag[]
  line_broadcasts LineBroadcast[]
  rich_menu_rules RichMenuRule[]
}

enum RichMenuStatus {
  draft
  published

  @@map("rich_menu_status")
}

/// LINEリッチメニュー(FR034)。公開(published)になったものだけがFR035の自動切替対象になる。
model RichMenu {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String         @db.VarChar(100)
  // LINE側で発行されるリッチメニューID。公開(LINEへの登録)が完了すると設定される。
  line_rich_menu_id String?        @db.VarChar(100)
  chat_bar_text     String         @db.VarChar(14)
  image_url         String?        @db.VarChar(500)
  // エリア分割パターンのプリセットキー(one/two/four/six)。
  layout            String         @db.VarChar(20)
  // プリセットの各エリアに対応するアクション定義: [{actionType, label, uri?, text?}]
  areas             Json
  status            RichMenuStatus @default(draft)
  // 複数のルールが同時に一致した場合、priorityが大きい方を優先する。
  priority          Int            @default(0)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  rules RichMenuRule[]
}

/// リッチメニューのタグ連動自動切替ルール(FR035)。応募者がtag_idのタグを持つ場合、
/// rich_menu_id(のうちpriorityが最も高いもの)がLINE上でそのユーザーに紐付けられる。
model RichMenuRule {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rich_menu_id String @db.Uuid
  tag_id       String @db.Uuid

  rich_menu RichMenu @relation(fields: [rich_menu_id], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([rich_menu_id, tag_id])
}

/// 学校マスター。
model School {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String     @unique @db.VarChar(200)
  type          SchoolType
  category      String?    @db.VarChar(50)
  sf_account_id String?    @db.VarChar(20)

  applicants Applicant[]
}

/// 求人媒体マスター。必須6媒体: マイナビ / Re就活キャンパス / OfferBox / キミスカ / キャリアチケット / ABABA
model Media {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String        @unique @db.VarChar(100)
  field_mapping Json
  sync_type     MediaSyncType
  cost          Int?

  applicant_sources ApplicantSource[]
}

/// QRコードマスター。
model QRCode {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label      String @db.VarChar(100)
  liff_url   String @db.VarChar(500)
  auto_tags  Json
  scan_count Int    @default(0)

  applicant_sources ApplicantSource[]
}

/// 選考フロー定義。
model SelectionFlow {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String  @db.VarChar(100)
  is_default Boolean
  is_active  Boolean

  stages     SelectionStage[]
  selections Selection[]
}

/// 選考ステージ定義。
model SelectionStage {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flow_id    String    @db.Uuid
  name       String    @db.VarChar(50)
  order      Int       @db.SmallInt
  stage_type StageType

  flow                 SelectionFlow        @relation(fields: [flow_id], references: [id])
  current_for          Selection[]          @relation("SelectionCurrentStage")
  history_from         SelectionHistory[]   @relation("SelectionHistoryFromStage")
  history_to           SelectionHistory[]   @relation("SelectionHistoryToStage")
  interviews           Interview[]          @relation("InterviewStage")
  evaluation_templates EvaluationTemplate[] @relation("EvaluationTemplateStage")
}

// ===== STEP 2: 応募者コア =====

enum ApplicantType {
  new_grad      @map("新卒")
  existing_grad @map("既卒")
  second_grad   @map("第二新卒")

  @@map("applicant_type")
}

enum PositionType {
  sogo
  gino

  @@map("position_type")
}

enum CallStatus {
  none
  callback_needed
  no_answer

  @@map("call_status")
}

enum HireType {
  new_grad
  mid_career

  @@map("hire_type")
}

/// 応募者テーブル（コアエンティティ）。
model Applicant {
  id                        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  last_name                 String        @db.VarChar(50)
  first_name                String        @db.VarChar(50)
  last_name_kana            String?       @db.VarChar(50)
  first_name_kana           String?       @db.VarChar(50)
  email                     String        @db.VarChar(255)
  phone                     String?       @db.VarChar(20)
  school_id                 String?       @db.Uuid
  department                String?       @db.VarChar(100)
  graduation_year           Int?          @db.SmallInt
  applicant_type            ApplicantType @default(new_grad)
  line_user_id              String?       @unique @db.VarChar(50)
  line_linked_at            DateTime?
  // FR033: LINE既読確認はAPI仕様上不可のため、マイページアクセス日時を
  // 「開封」の代替指標として使う(U-01参照)。
  mypage_last_accessed_at   DateTime?
  primary_source_id         String?       @unique @db.Uuid
  // AgencyContactテーブルは未実装(エージェント機能のPhaseで追加予定)のため、
  // 今はFK制約を張らずスカラーとして保持する。
  agency_contact_id         String?       @db.Uuid
  position_type             PositionType?
  memo                      String?
  document_deadline         DateTime?     @db.Date
  offer_acceptance_deadline DateTime?     @db.Date
  resume_url                String?       @db.VarChar(500)
  photo_url                 String?       @db.VarChar(500)
  call_status               CallStatus    @default(none)
  hire_type                 HireType      @default(new_grad)
  sf_contact_id             String?       @db.VarChar(20)
  sf_employment_cache       Json?
  created_at                DateTime      @default(now())
  updated_at                DateTime      @updatedAt

  school            School?                 @relation(fields: [school_id], references: [id])
  sources           ApplicantSource[]       @relation("ApplicantSources")
  primary_source    ApplicantSource?        @relation("ApplicantPrimarySource", fields: [primary_source_id], references: [id])
  tags              ApplicantTag[]
  line_tokens       LineRegistrationToken[]
  selection         Selection?
  line_messages     LineMessage[]
  call_logs         CallLog[]
  survey_recipients SurveyRecipient[]
  survey_responses  SurveyResponse[]

  @@index([email], map: "applicant_email_idx")
  @@index([sf_contact_id], map: "applicant_sf_idx")
  @@index([created_at(sort: Desc)], map: "applicant_created_idx")
}

/// 流入元テーブル。
model ApplicantSource {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicant_id          String  @db.Uuid
  media_id              String? @db.Uuid
  qr_code_id            String? @db.Uuid
  external_applicant_id String? @db.VarChar(100)
  raw_data              Json?

  applicant   Applicant  @relation("ApplicantSources", fields: [applicant_id], references: [id], onDelete: Cascade)
  media       Media?     @relation(fields: [media_id], references: [id])
  qr_code     QRCode?    @relation(fields: [qr_code_id], references: [id])
  primary_for Applicant? @relation("ApplicantPrimarySource")
}

/// タグ中間テーブル。
model ApplicantTag {
  applicant_id String   @db.Uuid
  tag_id       String   @db.Uuid
  tagged_at    DateTime @default(now())
  tagged_by    String?  @db.Uuid

  applicant    Applicant @relation(fields: [applicant_id], references: [id], onDelete: Cascade)
  tag          Tag       @relation(fields: [tag_id], references: [id])
  tagged_staff Staff?    @relation(fields: [tagged_by], references: [id])

  @@id([applicant_id, tag_id])
}

/// 架電履歴(FR109)。担当者が学生への電話を手動記録する(1学生に複数件登録可)。
model CallLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicant_id String   @db.Uuid
  staff_id     String   @db.Uuid
  called_at    DateTime
  result       String   @db.VarChar(50)
  note         String?
  created_at   DateTime @default(now())

  applicant Applicant @relation(fields: [applicant_id], references: [id], onDelete: Cascade)
  staff     Staff     @relation("CallLogStaff", fields: [staff_id], references: [id])

  @@index([applicant_id, called_at(sort: Desc)], map: "call_log_applicant_idx")
}

/// LINE連携ワンタイムトークン。
model LineRegistrationToken {
  token        String    @id @db.VarChar(64)
  applicant_id String    @db.Uuid
  expires_at   DateTime
  used_at      DateTime?
  created_at   DateTime  @default(now())

  applicant Applicant @relation(fields: [applicant_id], references: [id])
}

// ===== STEP 3: 選考管理 =====

enum SelectionResult {
  pending
  passed
  failed
  withdrawn
  offer_declined

  @@map("selection_result")
}

enum EvaluationItemType {
  score5
  score10
  text
  checkbox

  @@map("evaluation_item_type")
}

/// 個人選考記録テーブル。
model Selection {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicant_id     String          @unique @db.Uuid
  flow_id          String          @db.Uuid
  current_stage_id String          @db.Uuid
  result           SelectionResult @default(pending)
  assigned_to      String?         @db.Uuid

  applicant     Applicant          @relation(fields: [applicant_id], references: [id], onDelete: Cascade)
  flow          SelectionFlow      @relation(fields: [flow_id], references: [id])
  current_stage SelectionStage     @relation("SelectionCurrentStage", fields: [current_stage_id], references: [id])
  assignee      Staff?             @relation("SelectionAssignee", fields: [assigned_to], references: [id])
  history       SelectionHistory[]
  interviews    Interview[]

  @@index([current_stage_id], map: "selection_stage_idx")
  @@index([result], map: "selection_result_idx")
}

/// 選考履歴ログ(追記のみ)。
model SelectionHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  selection_id   String   @db.Uuid
  from_stage_id  String?  @db.Uuid
  to_stage_id    String   @db.Uuid
  changed_at     DateTime @default(now())
  changed_by     String   @db.Uuid
  note           String?
  decline_reason String?

  selection  Selection       @relation(fields: [selection_id], references: [id], onDelete: Cascade)
  from_stage SelectionStage? @relation("SelectionHistoryFromStage", fields: [from_stage_id], references: [id])
  to_stage   SelectionStage  @relation("SelectionHistoryToStage", fields: [to_stage_id], references: [id])
  staff      Staff           @relation("SelectionHistoryChangedBy", fields: [changed_by], references: [id])
}

/// 面接記録テーブル。
model Interview {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  selection_id           String   @db.Uuid
  stage_id               String   @db.Uuid
  interviewer_id         String   @db.Uuid
  // CalendarSlotテーブルは未実装(roadmap.html STEP5以降で追加予定)のため、
  // 今はFK制約を張らずスカラーとして保持する。
  calendar_slot_id       String?  @db.Uuid
  scheduled_at           DateTime
  score                  Int?     @db.SmallInt
  notes                  String?
  garoon_event_id        String?  @db.VarChar(100)
  is_evaluation_complete Boolean  @default(false)

  selection            Selection            @relation(fields: [selection_id], references: [id], onDelete: Cascade)
  stage                SelectionStage       @relation("InterviewStage", fields: [stage_id], references: [id])
  interviewer          Staff                @relation("InterviewInterviewer", fields: [interviewer_id], references: [id])
  evaluation_responses EvaluationResponse[]
}

/// 評価シートテンプレート。
model EvaluationTemplate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(100)
  stage_id   String?  @db.Uuid
  is_active  Boolean  @default(true)
  created_by String   @db.Uuid
  created_at DateTime @default(now())

  stage   SelectionStage?  @relation("EvaluationTemplateStage", fields: [stage_id], references: [id])
  creator Staff            @relation("EvaluationTemplateCreator", fields: [created_by], references: [id])
  items   EvaluationItem[]
}

/// 評価項目テーブル。
model EvaluationItem {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id String             @db.Uuid
  question    String             @db.VarChar(200)
  item_type   EvaluationItemType
  sort_order  Int                @db.SmallInt
  created_at  DateTime           @default(now())

  template  EvaluationTemplate   @relation(fields: [template_id], references: [id], onDelete: Cascade)
  responses EvaluationResponse[]
}

/// 評価回答テーブル(面接担当者の評価入力結果)。
model EvaluationResponse {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interview_id String   @db.Uuid
  item_id      String   @db.Uuid
  score        Int?     @db.SmallInt
  answer_text  String?
  submitted_by String   @db.Uuid
  submitted_at DateTime @default(now())

  interview Interview      @relation(fields: [interview_id], references: [id], onDelete: Cascade)
  item      EvaluationItem @relation(fields: [item_id], references: [id])
  submitter Staff          @relation("EvaluationResponseSubmitter", fields: [submitted_by], references: [id])

  @@unique([interview_id, item_id], map: "eval_resp_interview_idx")
}

// ===== LINE基本連携(FR030: 友だち登録・紐付け / FR031: メッセージ送信) =====
// RichMenu/Survey/ScenarioStep等の高度なLINE機能はPhase2以降(roadmap.html STEP5〜)。

enum LineMessageDirection {
  inbound
  outbound

  @@map("line_message_direction")
}

enum LineMessageType {
  text
  image
  file
  sticker
  template
  flex

  @@map("line_message_type")
}

/// LINEチャット履歴テーブル。
model LineMessage {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicant_id String               @db.Uuid
  broadcast_id String?              @db.Uuid
  direction    LineMessageDirection
  message_type LineMessageType      @default(text)
  content      String?
  file_url     String?              @db.VarChar(500)
  file_name    String?              @db.VarChar(200)
  is_read      Boolean              @default(false)
  sent_at      DateTime             @default(now())

  applicant Applicant      @relation(fields: [applicant_id], references: [id], onDelete: Cascade)
  broadcast LineBroadcast? @relation(fields: [broadcast_id], references: [id])

  @@index([applicant_id, sent_at(sort: Desc)], map: "linemsg_applicant_idx")
  @@index([is_read, direction, sent_at], map: "linemsg_unread_idx")
}

/// FR033: LINE一斉送信の送信履歴(1回の一斉送信操作を1レコードにまとめる)。
/// 開封率はLINE API仕様上個人の既読取得ができない(U-01)ため、
/// 「マイページアクセス日時が送信日時より後か」を暫定的な代替指標として使う。
model LineBroadcast {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_text   String
  tag_id          String?  @db.Uuid
  recipient_count Int      @db.SmallInt
  sent_count      Int      @db.SmallInt
  sent_by         String   @db.Uuid
  sent_at         DateTime @default(now())

  tag      Tag?          @relation(fields: [tag_id], references: [id])
  sender   Staff         @relation(fields: [sent_by], references: [id])
  messages LineMessage[]

  @@index([sent_at(sort: Desc)], map: "linebroadcast_sent_idx")
}

// ===== LINEアンケート(FR036) =====

enum SurveyStatus {
  draft
  published

  @@map("survey_status")
}

/// LINEアンケート(FR036)。LIFF経由で応募者本人が回答する。
/// 質問はJSONで保持する([{id, type: "text"|"single_choice"|"multi_choice", label, options?}])。
model Survey {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String       @db.VarChar(200)
  description String?
  questions   Json
  status      SurveyStatus @default(draft)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  recipients SurveyRecipient[]
  responses  SurveyResponse[]
}

/// アンケートの送信先台帳。送信に成功した応募者だけを記録し、
/// responseが無い行が「未回答者」(リマインド対象)になる。
model SurveyRecipient {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  survey_id    String    @db.Uuid
  applicant_id String    @db.Uuid
  sent_at      DateTime  @default(now())
  reminded_at  DateTime?

  survey    Survey    @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  applicant Applicant @relation(fields: [applicant_id], references: [id], onDelete: Cascade)

  @@unique([survey_id, applicant_id])
}

/// アンケート回答。1応募者につき1アンケート1件(再回答は上書き)。
model SurveyResponse {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  survey_id    String   @db.Uuid
  applicant_id String   @db.Uuid
  // [{questionId, value: string | string[]}]
  answers      Json
  submitted_at DateTime @default(now())

  survey    Survey    @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  applicant Applicant @relation(fields: [applicant_id], references: [id], onDelete: Cascade)

  @@unique([survey_id, applicant_id])
}
