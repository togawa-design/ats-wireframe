# ローカル開発用。Cloud Run本番ではSecret Manager/環境変数で設定する。
# (apps/rpa-worker/.env.example と同じ Cloud SQL インスタンスを共有する想定)
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres?schema=public"

GCP_PROJECT_ID=fujiarte-ats

# 本番(Cloud Run / Firebase App Hosting)では Cloud SQL Auth Proxy 経由のソケット接続を使う。
# INSTANCE_CONNECTION_NAME=fujiarte-ats:asia-northeast1:fujiarte-ats-db

# Firebase Auth (Google OAuth)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fujiarte-ats
NEXT_PUBLIC_FIREBASE_APP_ID=

# サーバー側でIDトークンを検証するための Firebase Admin SDK 認証情報。
# Cloud Run / App Hosting 上では Application Default Credentials を使うため未設定でよい。
# ローカル開発時のみサービスアカウントJSONのパスを指定する。
GOOGLE_APPLICATION_CREDENTIALS=

# LINE Messaging API (FR030: 友だち登録・紐付け / FR031: メッセージ送信)
# LINE Developers コンソールでMessaging APIチャネルを作成後に設定する。
# 本番ではSecret Managerに格納する(apps/rpa-worker/src/secrets.ts参照)。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LIFF registration page (src/app/line/register) 用。LINE Developers で作成したLIFFアプリのID。
NEXT_PUBLIC_LIFF_ID=

# LIFF マイページ(FR002: src/app/line/mypage)用。LINE Developersで作成した別LIFFアプリのID。
NEXT_PUBLIC_MYPAGE_LIFF_ID=
# マイページAPIでのLIFF IDトークン検証(LINEログインのサーバー側検証)に使うチャネルID(数値)。
LINE_LOGIN_CHANNEL_ID=

# LIFF アンケート回答ページ(FR036: src/app/line/survey)用。LINE Developersで作成した別LIFFアプリのID。
# ID Tokenの検証はマイページと同じLINE_LOGIN_CHANNEL_IDを使う。
NEXT_PUBLIC_SURVEY_LIFF_ID=

# FR002書類アップロードの保存先バケット。未設定時は `${NEXT_PUBLIC_FIREBASE_PROJECT_ID}.firebasestorage.app` を使う。
FIREBASE_STORAGE_BUCKET=
# ローカル開発/E2EでFirebase Storage Emulatorに接続する場合に設定する(例: 127.0.0.1:9199)。
FIREBASE_STORAGE_EMULATOR_HOST=
